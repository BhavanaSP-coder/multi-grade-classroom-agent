# Copy this file to .env and fill in your key:  Copy-Item .env.example .env
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional tuning
# Number of grade-content LLM calls run in parallel (lower it if you hit Groq rate limits)
MAX_CONCURRENCY=3
# Set to 0 to skip the LLM call that writes timetable task text (uses built-in text instead)
TIMETABLE_LLM=1
# Minimum cosine relevance (0-1) for a curriculum chunk to be shown/used
MIN_RELEVANCE=0.30
# Flask session secret (any long random string)
FLASK_SECRET_KEY=change-me
FLASK_DEBUG=0
PORT=5000
# Maximum periods per school day in the Adaptive Classroom Assistant (1-12, default 10)
MAX_PERIODS_PER_DAY=10
